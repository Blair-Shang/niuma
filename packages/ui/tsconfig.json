{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "strict": true,
    "jsx": "preserve",
    "types": ["vitest/globals", "node", "vite/client"],
    "paths": {
      "@ruoshui/ui": ["./src/index.ts"],
      "@niuma/ui": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "playground/**/*.ts", "playground/**/*.vue", "vite-plugins/**/*.ts"]
}
